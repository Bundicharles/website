# Environment / secrets
api/config/config.local.php
api/config/config.production.php
api/.env
.env
.env.*
!.env.example

# Uploads (don't commit user uploads to git)
api/uploads/images/*
!api/uploads/images/.gitkeep

# Setup script (delete after use)
api/setup/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
logs/

# Node (if used for tooling)
node_modules/
npm-debug.log*
yarn-error.log*

# Build artefacts
dist/
build/

# PHP session files
api/sessions/*
!api/sessions/.htaccess

# Private and generated uploads
api/uploads/images/*
!api/uploads/images/.gitkeep

# Temporary setup scripts
api/setup/

# Local database dumps and backups
*.sql.bak
*.sql.backup

# Documents uploads (don't commit user uploads to git)
api/uploads/documents/*
!api/uploads/documents/.gitkeep
